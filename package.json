{
  "name": "pathfinder-ai-trader",
  "version": "0.1.0",
  "private": true,
  "description": "Safety-first modular trading analysis platform.",
  "type": "module",
  "workspaces": [
    "apps/dashboard",
    "packages/*"
  ],
  "scripts": {
    "dev:dashboard": "npm --workspace apps/dashboard run dev",
    "build:dashboard": "npm --workspace apps/dashboard run build",
    "build:functions": "npm --prefix firebase/functions run build",
    "build:extension": "node scripts/build-extension.js",
    "test": "node --test",
    "test:extension": "node --test test/*.test.js",
    "test:functions": "npm --prefix firebase/functions run test",
    "lint": "npm run lint:app && npm run lint:extension",
    "lint:app": "eslint apps/dashboard/src packages eslint.config.js",
    "lint:dashboard": "npm --workspace apps/dashboard run lint",
    "lint:extension": "node --check browser/iq-option-reader/normalized-market-data.js && node --check browser/iq-option-reader/collector.js && node --check browser/iq-option-reader/debug-panel.js && node --check browser/iq-option-reader/content-script.js && node --check broker_engine/iq_option/market-data-adapter.js && node --check market_engine/market-data-provider.js && node --check scripts/build-extension.js && node --check test/collector.test.js && node --check test/normalized-market-data.test.js",
    "format": "prettier \"*.{md,json}\" \".github/**/*.{yml,yaml}\" \"apps/**/*.{ts,tsx,css,html,json,md,yaml,yml}\" \"docs/**/*.md\" \"firebase/**/*.{json,md,ts}\" \"packages/**/*.{ts,json,md}\" \"scripts/**/*.md\" \"services/*/README.md\" \"tests/**/*.md\" --write",
    "format:check": "prettier \"*.{md,json}\" \".github/**/*.{yml,yaml}\" \"apps/**/*.{ts,tsx,css,html,json,md,yaml,yml}\" \"docs/**/*.md\" \"firebase/**/*.{json,md,ts}\" \"packages/**/*.{ts,json,md}\" \"scripts/**/*.md\" \"services/*/README.md\" \"tests/**/*.md\" --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
